# These two values are intentionally public and protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Keep optional owner integrations disabled until their server-side credentials exist.
VITE_EMAIL_CODE_ENABLED=false
VITE_APPLE_AUTH_ENABLED=false
VITE_PREMIUM_USERNAME_ENABLED=false

# Never put SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, Apple private keys,
# webhook secrets, or any other secret in this file or in a VITE_* variable.
